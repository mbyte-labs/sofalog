<?xml version="1.0" encoding="utf-8"?>
<!--
   The library (the database) is backed up and transferred. The TMDB account's session is a secret
   and is kept in the no-backup directory (TmdbSessionStore), which neither includes.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
