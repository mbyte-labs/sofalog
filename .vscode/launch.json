{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "sofalog backend (Go)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/server",
      "cwd": "${workspaceFolder}/server"
    },
    {
      "name": "sofalog backend + frontend",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/server",
      "cwd": "${workspaceFolder}/server",
      "preLaunchTask": "frontend: vite dev",
      "postDebugTask": "frontend: stop vite"
    }
  ]
}
