{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sofalog-smoke",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATA_DIR=./data/smoke",
        "LISTEN_ADDR=:8090",
        "BASE_URL=http://localhost:8090",
        "./server/sofalog"
      ],
      "port": 8090
    },
    {
      "name": "sofalog-site",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "out=$(mktemp -d) && sh site/assemble.sh \"$out\" && exec python3 -m http.server 8091 -d \"$out\""
      ],
      "port": 8091
    }
  ]
}
