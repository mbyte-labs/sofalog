# sofalog configuration. Copy to .env (gitignored) and fill in:
#
#   cp env.example .env
#
# Read by docker compose and by the server. Real environment variables win.
# This template must never hold a real value.

# Required. Public URL users reach the app at (http://localhost:8080 for go run).
BASE_URL=https://media.example.com

# TMDB, from https://www.themoviedb.org/settings/api. Set ONE (v4 wins if both).
# Without one, browsing works but adding movies and shows fails.
TMDB_API_KEY_V3=
TMDB_API_KEY_V4=

# Country for the "where to watch" listings (two letters). Default RO.
#TMDB_WATCH_REGION=RO

# Time zone for users who haven't picked one (IANA name). Default UTC.
#DEFAULT_TIMEZONE=Europe/Bucharest

# TMDB refresh cadence: days (7d) or a duration (36h), minimum 1h, 0 = off.
# Active: watchlisted items and shows still airing. Archive: everything else.
#TMDB_REFRESH_INTERVAL=7d
#TMDB_ARCHIVE_REFRESH_INTERVAL=90d

# Steam game sync, from https://steamcommunity.com/dev/apikey
#STEAM_API_KEY=

# Jellyfin library scan: set both or neither. The key is from Jellyfin's
# Administration -> API Keys. While set, the scan owns the Jellyfin tile.
#JELLYFIN_URL=http://jellyfin.lan:8096
#JELLYFIN_API_KEY=
# Same syntax as the refresh cadence; 0 = only the "Scan now" button.
#JELLYFIN_SCAN_INTERVAL=6h

#LISTEN_ADDR=:8080
#DATA_DIR=./data

# Reverse proxy IPs or CIDRs, comma separated. Empty ignores X-Forwarded-*.
#TRUSTED_PROXIES=

# Explicit env file path instead of searching for .env / ../.env.
#ENV_FILE=/etc/sofalog/env

# OIDC single sign-on: set all three or none. Enabling it DISABLES password
# login. Accounts match by verified email, so fix mismatched addresses under
# Settings -> Users first. Redirect URI: {BASE_URL}/api/v1/auth/oidc/callback
#OIDC_ISSUER=https://idp.example.com/realms/home
#OIDC_CLIENT_ID=sofalog
#OIDC_CLIENT_SECRET=

# Optional: the claim and value that grant admin. Empty = no admins.
#OIDC_ADMIN_CLAIM=groups
#OIDC_ADMIN_VALUE=sofalog-admins

#OIDC_SCOPES=openid profile email
#OIDC_PROVIDER_NAME=single sign-on
