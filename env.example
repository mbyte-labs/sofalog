# sofalog configuration — copy to .env and fill in.
#
#   cp env.example .env
#
# .env is gitignored. It is read by `docker compose` for interpolation, and by
# the server itself: a real environment variable always wins over this file, so
# a container or systemd unit overrides it rather than the reverse.
#
# Named env.example rather than .env.example so tooling that blocks .env.* for
# secrets does not also block this template. It must never hold a real value.

# Required. The absolute external URL users reach the app at. Use
# http://localhost:8080 for local work.
BASE_URL=http://localhost:8080

# TMDB metadata for movies and TV. Server-side only — never sent to the browser
# and never logged. Get a credential at https://www.themoviedb.org/settings/api,
# which shows two fields. FILL IN ONE — they grant the same access, and sofalog
# only calls v3 endpoints. If both are set the v4 token is used.
#
# Neither set means adding movies and shows fails; browsing what you already
# track is unaffected. A value in the wrong variable is ignored with a warning.

# The "API Key" field — a short opaque string.
TMDB_API_KEY_V3=

# The "API Read Access Token" field — a long JWT starting with eyJ.
TMDB_API_KEY_V4=

# Which country's "where to watch" listing the detail pages show (D-022).
# ISO-3166-1 alpha-2. Snapshots store only this country's listing, so changing
# it costs each tracked item one automatic refresh on its next view. A value
# that is not two letters is a startup error. Defaults to US.
#TMDB_WATCH_REGION=US

# The time zone of every user who has not picked one on their Account page
# (D-038): it decides where their day ends — which episodes count as aired,
# what the Upcoming calendar calls "Today" — and the zone dates and times are
# shown in. An IANA name; an unknown one is a startup error. Defaults to UTC.
# Every timestamp is stored in UTC whatever this says.
#DEFAULT_TIMEZONE=Europe/Bucharest

# The scheduled TMDB refresh (D-025): two jobs on one hourly check. Each value
# is a whole number of days (7d) or a duration (36h); 0 disables that job; a
# non-zero value under 1h, or a mixed form like 7d12h, is a startup error.
# Defaults shown.
#
# Active: every movie and show on any watchlist, plus followed shows TMDB still
# lists as in production.
#TMDB_REFRESH_INTERVAL=7d
# Archive: watched movies, and followed shows TMDB has ended or cancelled, when
# neither is on any watchlist.
#TMDB_ARCHIVE_REFRESH_INTERVAL=90d

# Steam game sync (M4). Server-wide, from https://steamcommunity.com/dev/apikey
#STEAM_API_KEY=

# Jellyfin library scan (D-033). Set both to have sofalog scan the household's
# Jellyfin server and light the Jellyfin tile under "Watch now" by itself, for
# every user; setting only one is a startup error. The key is an API key from
# Jellyfin's dashboard (Administration -> API Keys), server-side only. While
# these are set the Jellyfin tile can no longer be set by hand — the scan owns
# it. Movies and seasons are matched by the TMDB id Jellyfin's metadata carries.
#JELLYFIN_URL=http://jellyfin.lan:8096
#JELLYFIN_API_KEY=

# How often the scan runs: days (1d) or a duration (6h); 0 leaves only the
# "Scan now" button under Settings -> Jellyfin; under 1h is a startup error.
# Default shown.
#JELLYFIN_SCAN_INTERVAL=6h

# Optional. Defaults shown.
#LISTEN_ADDR=:8080
#DATA_DIR=./data

# Optional. CIDRs or IPs of the reverse proxy, comma separated. Empty means
# X-Forwarded-* headers are ignored entirely.
#TRUSTED_PROXIES=

# Optional. An explicit path to the env file, overriding the .env / ../.env
# search. A path that does not exist is a startup error.
#ENV_FILE=/etc/sofalog/env

# Single sign-on (OpenID Connect). Set all three to enable it; setting only
# some is a startup error. Enabling OIDC DISABLES the built-in email and
# password login completely — the provider becomes the only way in, and the
# first-run setup form is replaced by a sign-in button.
#
# Accounts attach to an identity by VERIFIED email — the same address they
# sign in with locally. If someone's provider address differs, update it under
# Settings -> Users before switching so they keep their history.
#
# Register {BASE_URL}/api/v1/auth/oidc/callback with the provider; the exact
# value is logged at startup.
#OIDC_ISSUER=https://idp.example.com/realms/home
#OIDC_CLIENT_ID=sofalog
#OIDC_CLIENT_SECRET=

# Optional. Which group/role claim grants admin, re-read on every sign-in.
# Leave both empty and nobody is an admin.
#OIDC_ADMIN_CLAIM=groups
#OIDC_ADMIN_VALUE=sofalog-admins

# Optional. Defaults shown.
#OIDC_SCOPES=openid profile email
#OIDC_PROVIDER_NAME=single sign-on
